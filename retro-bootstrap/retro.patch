-        description: "Post release/discord.md to the testers' channel after publishing"
-        type: boolean
-        default: true
-      version:
-        description: "discord-repost only: the release to post again, e.g. 2610-541"
-        type: string
-        default: ""
-
-permissions:
-  contents: read
-
-# One release at a time: a second run waits instead of racing for the tag.
-concurrency:
-  group: release
-  cancel-in-progress: false
