+# SPDX-FileCopyrightText: 2026 RiftWii contributors
+# SPDX-License-Identifier: GPL-3.0-or-later
+name: Retro USB experimental
+on:
+  push:
+    branches: [main]
+    tags: ['v*']
+  workflow_dispatch:
+permissions:
+  contents: write
+jobs:
+  build:
+    runs-on: ubuntu-24.04
+    container: devkitpro/devkitppc@sha256:44cb1a920e1ec3ec7c06767493c3b85f8d643d6137cc4661f0201895ac6e4967
+    steps:
+      - uses: actions/checkout@v5
+        with:
+          fetch-depth: 0
+      - name: Import recovered source and preserve upstream history
+        if: ${{ hashFiles('CMakeLists.txt') == '' }}
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: bash retro-bootstrap/import.sh
+      - name: Select source
+        shell: bash
+        run: |
+          if [ -f imported/CMakeLists.txt ]; then echo "SOURCE=$PWD/imported" >> "$GITHUB_ENV"; else echo "SOURCE=$PWD" >> "$GITHUB_ENV"; fi
+      - name: Prepare host tools
+        run: apt-get update -qq && apt-get install -y -qq cmake ninja-build zlib1g-dev zstd python3-pip && python3 -m pip install --break-system-packages py7zr==1.0.0
+      - name: Compile and test
+        shell: bash
+        run: |
+          set -euo pipefail
+          cd "$SOURCE"
+          cmake -S . -B build-host -G Ninja
+          cmake --build build-host -j4
+          ctest --test-dir build-host -j4 --output-on-failure
+          make -f Makefile.wii -j4 RIFTWII_COMMITS=700 RIFTWII_VERSION=2610-700-retro-alpha RIFTWII_COMMIT=retrodev RIFTWII_BUILD_STAMP=2610-700-retro-alpha-gretrodev
+          python3 tools/make_plugin.py check --dol build_wii/riftwii-unpacked.dol build-plugins/plugins/*.rwp
+          python3 retro-integration/package.py
+      - uses: actions/upload-artifact@v4
+        with:
+          name: Retro-USB-alpha-kit
+          path: ${{ env.SOURCE }}/dist/*
+          if-no-files-found: error
+      - name: Publish experimental tagged release
+        if: startsWith(github.ref, 'refs/tags/v0.')
+        env:
+          GH_TOKEN: ${{ github.token }}
+          TAG: ${{ github.ref_name }}
+        shell: bash
+        run: |
+          set -euo pipefail
+          command -v gh || { echo 'gh unavailable: artifact is retained; release not published'; exit 1; }
+          gh release create "$TAG" "$SOURCE"/dist/* --repo danipaises/RiftWii-retro-USB-Only --prerelease --title "Retro USB experimental $TAG" --notes-file "$SOURCE/retro-integration/STATUS.md"
+      - name: Reject premature Complete releases
+        if: startsWith(github.ref, 'refs/tags/v1.')
+        run: echo 'v1 Complete blocked until interface, saves and return requirements are verified'; exit 1
